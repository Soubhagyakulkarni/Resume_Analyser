# Copy to .env for local development. Never put a real key in this example file.
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
MAX_UPLOAD_BYTES=10485760
MAX_RESUME_CHARS=50000
SQLITE_DATABASE_PATH=./data/jobs.sqlite3
JOB_LISTING_MAX_AGE_DAYS=30
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY_CODE=in
LOG_LEVEL=INFO
